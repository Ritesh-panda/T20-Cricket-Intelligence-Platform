# Environment Configuration for T20 Cricket Intelligence Platform
# Copy this file to .env and fill in environment-specific values

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Storage Paths (Local-first)
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
MODELS_CACHE_DIR=./models/cache

# Database (PostgreSQL optional for local-first mode; SQLite supported for zero-setup dev)
DATABASE_URL=sqlite:///./data/cricket_intelligence.db
# DATABASE_URL=postgresql://cricket_user:cricket_pass@localhost:5432/cricket_intel

# Web Acquisition Settings
CRAWLER_USER_AGENT=T20CricketResearchBot/1.0 (+https://example.org/t20-intel; research@example.org)
CRAWLER_DEFAULT_RATE_LIMIT_RPS=0.5
CRAWLER_REQUEST_TIMEOUT_SEC=15
CRAWLER_MAX_RETRIES=3

# NLP & Embedding Models
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SPACY_MODEL_NAME=en_core_web_sm

# Dashboard & API
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=5173
